mapscripts NightshadeTown_Horror_HouseA_1F_MapScripts {}

script EventScript_Color_Puzzle_Add {
    lock
    call(Common_EventScript_Puzzle_Add_01)

    if(var(VAR_RESULT) == 1) {
        message(format("Correct"))
    }
    else {
        message(format("False"))
    }

    waitmessage
    waitbuttonpress
    closemessage
    release
}