}

script Common_EventScript_Puzzle_Hint_Multiply_01 {
    setvar(VAR_TEMP_0, COLOR_PUZZLE_HINT_MULTIPLY_01_MON_01)
    setvar(VAR_TEMP_1, COLOR_PUZZLE_HINT_MULTIPLY_01_MON_02)
    setvar(VAR_TEMP_2, 0)
    setvar(VAR_TEMP_3, COLOR_PUZZLE_HINT_MULTIPLY_01_MON_03)
    call(Common_EventScript_Puzzle_Setup)
